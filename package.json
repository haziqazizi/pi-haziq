{
  "name": "pi-haziq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A cohesive, opinionated Pi coding-agent package composed from reviewed extensions and first-party integration hooks.",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haziqazizi/pi-haziq.git"
  },
  "pi": {
    "extensions": [
      "./node_modules/pi-multi-pass/extensions",
      "./node_modules/pi-tool-repair/tool-repair.ts",
      "./node_modules/@monotykamary/pi-loop/src/index.ts",
      "./node_modules/@monotykamary/pi-supervisor/src/index.ts",
      "./node_modules/pi-invisible-continue/continue.ts",
      "./node_modules/@tmustier/pi-queue-steer/index.ts",
      "./node_modules/pi-reason-harness/extensions",
      "./node_modules/pi-autoresearch-harness/extensions",
      "./extensions/haziq-meridian-refresh.ts",
      "./node_modules/@juicesharp/rpiv-todo/index.ts",
      "./extensions/haziq-service-tier.ts",
      "./node_modules/pi-image-preview/index.ts",
      "./extensions/haziq-mcp.ts",
      "./node_modules/@lll9p/pi-better-compaction/index.ts",
      "./extensions/haziq-fabric.ts",
      "./extensions/haziq-cohesion.ts",
      "./node_modules/pi-web-access/index.ts",
      "./node_modules/pi-agent-browser-native/dist/extensions/agent-browser/index.js"
    ],
    "skills": [
      "./node_modules/pi-fabric/skills/fabric-exec",
      "./node_modules/pi-fabric/skills/fabric-guide",
      "./node_modules/pi-fabric/skills/fabric-workflow",
      "./node_modules/pi-fabric/skills/fabric-council",
      "./node_modules/pi-fabric/skills/fabric-fusion",
      "./node_modules/pi-fabric/skills/fabric-rlm",
      "./node_modules/pi-fabric/skills/fabric-schema",
      "./node_modules/pi-fabric/skills/fabric-advisor",
      "./node_modules/pi-fabric/skills/fabric-supervisor",
      "./node_modules/pi-fabric/skills/fabric-spec",
      "./node_modules/pi-fabric/skills/fabric-ambient",
      "./node_modules/pi-fabric/skills/fabric-swarm",
      "./node_modules/pi-reason-harness/skills/reason-harness",
      "./node_modules/@haziqazizi/herdr-factory/skills/herdr-guide",
      "./node_modules/@haziqazizi/herdr-factory/skills/herdr-factory"
    ]
  },
  "dependencies": {
    "@haziqazizi/herdr-factory": "github:haziqazizi/herdr-factory",
    "@juicesharp/rpiv-todo": "2.1.0",
    "@lll9p/pi-better-compaction": "0.2.1",
    "@monotykamary/pi-loop": "0.1.17",
    "@monotykamary/pi-supervisor": "0.5.13",
    "@tmustier/pi-queue-steer": "https://github.com/monotykamary/pi-queue-steer/archive/ff755456bc67c904c2f659bf7873541bc386b0b1.tar.gz",
    "pi-agent-browser-native": "0.2.72",
    "pi-autoresearch-harness": "1.0.4",
    "pi-fabric": "0.40.1",
    "pi-image-preview": "0.1.5",
    "pi-invisible-continue": "0.3.6",
    "pi-mcp-adapter": "2.14.0",
    "pi-multi-pass": "1.3.0",
    "pi-openai-service-tier": "0.1.4",
    "pi-reason-harness": "1.0.7",
    "pi-tool-repair": "0.1.10",
    "pi-web-access": "0.15.0"
  },
  "bundledDependencies": [
    "@juicesharp/rpiv-todo",
    "@lll9p/pi-better-compaction",
    "pi-image-preview",
    "pi-mcp-adapter",
    "pi-multi-pass",
    "pi-openai-service-tier",
    "pi-fabric",
    "pi-tool-repair",
    "@monotykamary/pi-loop",
    "@monotykamary/pi-supervisor",
    "pi-reason-harness",
    "pi-invisible-continue",
    "pi-autoresearch-harness",
    "@tmustier/pi-queue-steer"
  ],
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": ">=0.82.0",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.82.0",
    "@earendil-works/pi-ai": "0.82.0",
    "@earendil-works/pi-coding-agent": "0.82.0",
    "@earendil-works/pi-tui": "0.82.0",
    "@types/node": "^22.19.0",
    "tsx": "^4.22.1",
    "typebox": "1.3.8",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "smoke": "node test/package-smoke.mjs",
    "smoke:trust": "node test/trust-smoke.mjs",
    "smoke:meridian": "node test/meridian-package-smoke.mjs",
    "smoke:production": "test/production-package-smoke.sh",
    "audit:production": "node scripts/audit-production.mjs",
    "verify": "npm run check && npm test && npm run smoke && npm run smoke:trust && npm run smoke:meridian",
    "verify:full": "npm run verify && npm run smoke:production && npm run audit:production && npm run smoke:fabric-binaries && npm run smoke:fabric-herdr-agent",
    "smoke:fabric-binaries": "node test/fabric-binaries-live.mjs",
    "smoke:fabric-herdr-agent": "node test/fabric-herdr-agent-e2e.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "@hono/node-server": "1.19.15",
    "fast-uri": "3.1.5",
    "hono": "4.12.34"
  },
  "bundleDependencies": [
    "@juicesharp/rpiv-todo",
    "@lll9p/pi-better-compaction",
    "pi-image-preview",
    "pi-mcp-adapter",
    "pi-multi-pass",
    "pi-openai-service-tier",
    "pi-fabric",
    "pi-tool-repair",
    "@monotykamary/pi-loop",
    "@monotykamary/pi-supervisor",
    "pi-reason-harness",
    "pi-invisible-continue",
    "pi-autoresearch-harness",
    "@tmustier/pi-queue-steer"
  ]
}
